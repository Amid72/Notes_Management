# =========================================================
# NotesVault Environment Variables Configuration
# =========================================================
# Copy this file to .env for local development:
#   copy .env.example .env

# Flask Secret Key (use a long, random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Configuration (MySQL / TiDB Cloud / Aiven)
# For local development:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=notes_db
DB_PORT=3306

# For Cloud MySQL (e.g. TiDB Cloud / Aiven / Railway):
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_USER=your_username.root
# DB_PASSWORD=your_password
# DB_NAME=notes_db
# DB_PORT=4000
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Email / OTP Settings (Gmail SMTP with App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com
